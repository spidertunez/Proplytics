                "to": [
                    "Amrabdelhadi1000@gmail.com"
                ],
                "content": "<h2>Deal Successfully Closed</h2>\r\n<p>Dear Manager,</p>\r\n<p>A deal has been successfully closed. Here are the details:</p>\r\n<table>\r\n  <tr><td><strong>Deal ID:</strong></td><td> {{1.DealID}} </td></tr>\r\n  <tr><td><strong>Customer Name:</strong></td><td> {{1.CustomerName}} </td></tr>\r\n  <tr><td><strong>Agent Name:</strong></td><td> {{1.AgentName}} </td></tr>\r\n  <tr><td><strong>Total Amount:</strong></td><td> {{1.TotalAmount}} EGP</td></tr>\r\n  <tr><td><strong>Commission Amount:</strong></td><td> {{1.CommissionAmount}} EGP</td></tr>\r\n</table>\r\n<p>Best regards,<br>Proplytics System</p>",
                "subject": "Deal Closed:  {{1.CustomerName}}-{{1.TotalAmount}} EGP",
                "bodyType": "rawHtml"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "cc": {
                            "mode": "chose"
