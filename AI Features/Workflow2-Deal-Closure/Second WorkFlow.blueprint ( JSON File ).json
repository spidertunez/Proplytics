                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "google-email"
                            },
                            "label": "Proplytics Gmail (amr.abdelhadi.aboelrish@gmail.com)"
                        }
